// Значения по умолчанию — с ними проект собирается сразу после клонирования,
// но без подписи под устройство.
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example

// Свои значения клади в Configs/Local.xcconfig — он не в гите.
