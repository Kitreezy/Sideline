// Скопируй в Configs/Local.xcconfig и подставь свои значения.
// Этот файл в гите, Local.xcconfig — нет.

// Team ID из Xcode → Settings → Accounts → твой Apple ID → Manage Certificates,
// либо из developer.apple.com → Membership.
DEVELOPMENT_TEAM = ЗАПОЛНИ_МЕНЯ

// Любой уникальный префикс. Bundle id получится <префикс>.tennisform
BUNDLE_ID_PREFIX = com.example
