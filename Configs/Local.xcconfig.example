// Скопируй в Configs/Local.xcconfig и подставь свои значения:
//
//   cp Configs/Local.xcconfig.example Configs/Local.xcconfig
//
// Team ID — в Xcode → Settings → Accounts → твой Apple ID → Manage Certificates,
// либо на developer.apple.com → Membership.

DEVELOPMENT_TEAM = ЗАПОЛНИ_МЕНЯ

// Любой уникальный префикс. Bundle id получится <префикс>.tennisform
BUNDLE_ID_PREFIX = com.example
