// Скопируй в Configs/Local.xcconfig (или запусти ./Scripts/bootstrap.sh)
// и впиши свои значения. Файл не в гите.
//
// DEVELOPMENT_TEAM — Xcode → Settings → Accounts → твой Apple ID →
// Manage Certificates, либо developer.apple.com → Membership.
// Пустым его оставить можно: проект соберётся, но на устройство не встанет.

DEVELOPMENT_TEAM =

// Любой уникальный префикс. Bundle id получится <префикс>.tennisform
BUNDLE_ID_PREFIX = com.example
